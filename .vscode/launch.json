    "version": "0.2.0",
    "configurations": [ 
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Pytest: tests in test/ (project)",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q",
                "test/"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run test_allgens with args",
            "type": "python",
            "request": "launch",
            "program": "c:/Users/Dragos/Roba/Lectures/YM2.2/Thesis/e Models/scripts/trying_things/test_occgens_all.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                    // -o 1.0  -f lines -l true -r false -m true -a 0.2 -s false
                    "-o", "0.5",    // occlusion ratio
                    "-f", "lines",  // masking function
                    "-l", "True",   // use label smoothing
                    "-r", "False",  // redirect output
                    "-m", "True",  // do mismatch on emotion-landmarks
                    "-a", "0.2",    // matching_amount = 20% (i.e. out of 50 images 10 will be matching, the rest will be of some mismatch type (every 4))
                    "-s", "False",  // use small subset (only 100 images per set)
                ]
        },
        {
            "name": "Run try_training with args",
            "type": "python",
            "request": "launch",
            "program": "c:/Users/Dragos/Roba/Lectures/YM2.2/Thesis/e Models/scripts/trying_things/try_training.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                    // --occ-prob 0.6 --batch_size 64 --model_name ConvNeXt --FT_EPOCH 300  --dropout_rate 0.5 --learning_rate  0.0001 --l2_reg 0.00200041712955451
                    "--batch_size", "64",
                    "--occ-prob", "0.6",
                    "--model_name", "ConvNeXt",
                    "--FT_EPOCH", "300",
                    "--dropout_rate", "0.5",
                    "--learning_rate", "0.0001",
                    "--l2_reg", "0.00200041712955451"
                ]
        },
        {
            "name": "occlude_dataset_offline",
            "type": "python",
            "request": "launch",
            "program": "c:/Users/Dragos/Roba/Lectures/YM2.2/Thesis/e Models/scripts/occlude_dataset_offline.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                    // --mismatch angry --pos_or_neg positive --batch_size 16 --small_subset --show_images -d
                    "--mismatch", "angry",
                    "--pos_or_neg", "positive",
                    "--batch_size", "16",
                    "--small_subset",
                    "--show_images",
                    "-d",
                ]
        },

    ]
}